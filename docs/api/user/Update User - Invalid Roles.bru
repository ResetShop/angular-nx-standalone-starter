meta {
  name: Update User - Invalid Roles
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/users/2
  body: json
  auth: none
}

body:json {
  {
    "roleIds": [9999]
  }
}

docs {
  # Update User - Invalid Roles

  Demonstrates the error response when replacing a user's roles with role IDs that don't
  exist in the system (or dropping a non-removable role): the request returns 400.
}

assert {
  res.status: eq 400
  res.body.error: isDefined
}

tests {
  test("should return 400 bad request", function() {
    expect(res.status).to.equal(400);
  });

  test("should return roles-not-found error", function() {
    expect(res.body.error).to.include("Roles not found");
  });
}
